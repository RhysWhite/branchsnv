#NEXUS
BEGIN DATA;
    DIMENSIONS NTAX=5 NCHAR=6;
    FORMAT SYMBOLS="ACGT" MISSING=? GAP=-;
    TAXLABELS Outgroup A B C D;
    CHARLABELS ref_1 ref_2 ref_3 ref_4 ref_5 ref_6;
    MATRIX
        Outgroup GGGCGG
        A        AAAC?C
        B        AAGCAC
        C        GGGCGA
        D        GAGCGA
    ;
END;
